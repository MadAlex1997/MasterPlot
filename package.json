{
  "name": "masterplot",
  "version": "1.0.3",
  "description": "Production-grade scientific plotting engine with WebGL rendering",
  "license": "MIT",
  "author": "Alexander Carey",
  "homepage": "https://madalex1997.github.io/MasterPlot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadAlex1997/MasterPlot.git"
  },
  "bugs": {
    "url": "https://github.com/MadAlex1997/MasterPlot/issues"
  },
  "keywords": [
    "webgl",
    "deck.gl",
    "plotting",
    "charting",
    "visualization",
    "scientific-computing",
    "scatter-plot",
    "roi",
    "react",
    "canvas",
    "gpu"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "lib/index.cjs.js",
  "module": "lib/index.esm.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./lib/index.esm.js",
      "require": "./lib/index.cjs.js"
    },
    "./ui": {
      "types": "./ui/index.d.ts",
      "import": "./lib/ui.esm.js",
      "require": "./lib/ui.cjs.js"
    },
    "./loaders": {
      "types": "./loaders/index.d.ts",
      "import": "./lib/loaders.esm.js",
      "require": "./lib/loaders.cjs.js"
    }
  },
  "files": [
    "lib/",
    "src/",
    "ui/",
    "loaders/",
    "AGENTS_USAGE.md"
  ],
  "scripts": {
    "start": "webpack serve --mode development --open",
    "dev": "webpack serve --mode development",
    "build:demo": "webpack --mode production",
    "build:lib": "rollup -c rollup.config.mjs",
    "build": "npm run build:lib && npm run build:demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p test-types",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@deck.gl/core": ">=9 <10",
    "@deck.gl/layers": ">=9 <10",
    "@loaders.gl/arrow": ">=4.3.4 <5",
    "@loaders.gl/core": ">=4.3.4 <5",
    "@loaders.gl/csv": ">=4.3.4 <5",
    "@loaders.gl/netcdf": ">=4.3.4 <5",
    "@loaders.gl/parquet": ">=4.3.4 <5",
    "@loaders.gl/schema": ">=4.3.4 <5",
    "@luma.gl/core": ">=9 <10",
    "d3-format": ">=3 <4",
    "d3-scale": ">=4 <5",
    "d3-time-format": ">=4 <5",
    "events": ">=3 <4",
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "zstd-codec": ">=0.1.5 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@loaders.gl/arrow": {
      "optional": true
    },
    "@loaders.gl/core": {
      "optional": true
    },
    "@loaders.gl/csv": {
      "optional": true
    },
    "@loaders.gl/netcdf": {
      "optional": true
    },
    "@loaders.gl/parquet": {
      "optional": true
    },
    "@loaders.gl/schema": {
      "optional": true
    },
    "zstd-codec": {
      "optional": true
    }
  },
  "dependencies": {
    "fft-windowing": "^0.1.4",
    "fft.js": "^4.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.15",
    "@eslint/js": "^9.39.5",
    "@loaders.gl/arrow": "^4.3.4",
    "@loaders.gl/core": "^4.3.4",
    "@loaders.gl/csv": "^4.3.4",
    "@loaders.gl/netcdf": "^4.3.4",
    "@loaders.gl/parquet": "^4.3.4",
    "@loaders.gl/schema": "^4.3.4",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-loader": "^9.1.3",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "crypto-browserify": "^3.3.0",
    "css-loader": "^6.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "html-webpack-plugin": "^5.5.3",
    "jsdom": "^29.1.1",
    "lz4js": "^0.2.0",
    "mermaid": "^11.12.3",
    "path-browserify": "^1.0.1",
    "prismjs": "^1.30.0",
    "process": "^0.11.10",
    "rollup": "^4.60.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "snappyjs": "^0.7.0",
    "stream-browserify": "^3.0.0",
    "style-loader": "^3.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3",
    "zstd-codec": "^0.1.5"
  }
}
